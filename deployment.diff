diff --git a/services/websocket.js b/services/websocket.js
new file mode 100644
index 0000000..c3d4e5f
--- /dev/null
+++ b/services/websocket.js
@@ -0,0 +1,68 @@
+const WebSocket = require('ws');
+const { processMessage, sendAck, sendReadAck } = require('./messages');
+
+function setupWebSocket(server, sessions, connections, users, messageStore) {
+  const wss = new WebSocket.Server({ server });
+
+  wss.on('connection', (ws, req) => {
+    const cookies = parseCookies(req.headers.cookie || '');
+    const sessionId = cookies.sessionId;
+    const session = sessions.get(sessionId);
+
+    if (!session) {
+      ws.close(4001, 'Invalid or expired session');
+      return;
+    }
+
+    const userId = session.userId;
+    if (connections.has(userId)) {
+      ws.close(4002, 'User already connected');
+      return;
+    }
+
+    connections.set(userId, ws);
+    console.log(`[WS] ${userId} connected`);
+
+    ws.on('message', async (data) => {
+      try {
+        const message = JSON.parse(data.toString());
+        if (message.type === 'message') {
+          const result = await processMessage(message, userId, connections, messageStore);
+          if (result.success) {
+            ws.send(JSON.stringify({ type: 'sent', messageId: result.messageId }));
+            console.log(`[MSG] ${result.messageId} from=${userId} to=${message.to} status=SENT`);
+          } else {
+            ws.send(JSON.stringify({ type: 'error', error: result.error }));
+            if (result.undeliverable) {
+              console.log(`[MSG] ${result.messageId} from=${userId} to=${message.to} status=UNDELIVERABLE`);
+            }
+          }
+        } else if (message.type === 'delivered') {
+          await sendAck(message, userId, connections, messageStore);
+          console.log(`[ACK] ${message.messageId} from=${userId} status=DELIVERED`);
+        } else if (message.type === 'read') {
+          await sendReadAck(message, userId, connections, messageStore);
+          console.log(`[ACK] ${message.messageId} from=${userId} status=READ`);
+        }
+      } catch (error) {
+        console.error('[WS] Message handling error:', error);
+        ws.send(JSON.stringify({ type: 'error', error: 'Invalid message format' }));
+      }
+    });
+
+    ws.on('close', () => {
+      connections.delete(userId);
+      console.log(`[WS] ${userId} disconnected`);
+    });
+
+    ws.on('error', (error) => {
+      console.error(`[WS] ${userId} error:`, error);
+      connections.delete(userId);
+    });
+  });
+
+  function parseCookies(cookieHeader) {
+    const cookies = {};
+    cookieHeader.split(';').forEach(cookie => {
+      const [name, value] = cookie.trim().split('=');
+      if (name && value) cookies[name] = value;
+    });
+    return cookies;
+  }
+}
+
+module.exports = { setupWebSocket };
diff --git a/services/messages.js b/services/messages.js
new file mode 100644
index 0000000..d4e5f6a
--- /dev/null
+++ b/services/messages.js
@@ -0,0 +1,58 @@
+const crypto = require('crypto');
+
+function initializeMessages(messageStore, maxLength) {
+  messageStore.maxLength = maxLength;
+  messageStore.messages = new Map();
+  messageStore.pendingAcks = new Map();
+}
+
+async function processMessage(message, fromUserId, connections, messageStore) {
+  const { to, content } = message;
+  
+  if (!to || !content || typeof content !== 'string') {
+    return { success: false, error: 'Invalid message format' };
+  }
+
+  if (content.length > messageStore.maxLength) {
+    return { success: false, error: 'Message too long' };
+  }
+
+  if (!connections.has(to)) {
+    return { success: false, error: 'Recipient offline', undeliverable: true };
+  }
+
+  const messageId = `MSG-${crypto.randomBytes(4).toString('hex').toUpperCase()}`;
+  const messageData = {
+    id: messageId,
+    from: fromUserId,
+    to,
+    content,
+    timestamp: Date.now(),
+    status: 'SENT',
+    deliveredAt: null,
+    readAt: null
+  };
+
+  messageStore.messages.set(messageId, messageData);
+  messageStore.pendingAcks.set(messageId, { delivered: false, read: false });
+
+  const recipientWs = connections.get(to);
+  if (recipientWs && recipientWs.readyState === WebSocket.OPEN) {
+    recipientWs.send(JSON.stringify({
+      type: 'message',
+      messageId,
+      from: fromUserId,
+      content,
+      timestamp: messageData.timestamp
+    }));
+  }
+
+  return { success: true, messageId };
+}
+
+async function sendAck(ackMessage, fromUserId, connections, messageStore) {
+  const { messageId } = ackMessage;
+  const message = messageStore.messages.get(messageId);
+  
+  if (!message) return;
+  if (message.to !== fromUserId) return;
+  
+  const pending = messageStore.pendingAcks.get(messageId);
+  if (!pending || pending.delivered) return;
+
+  pending.delivered = true;
+  message.status = 'DELIVERED';
+  message.deliveredAt = Date.now();
+  
+  const senderWs = connections.get(message.from);
+  if (senderWs && senderWs.readyState === WebSocket.OPEN) {
+    senderWs.send(JSON.stringify({ type: 'delivered', messageId }));
+  }
+}
+
+async function sendReadAck(ackMessage, fromUserId, connections, messageStore) {
+  const { messageId } = ackMessage;
+  const message = messageStore.messages.get(messageId);
+  
+  if (!message) return;
+  if (message.to !== fromUserId) return;
+  
+  const pending = messageStore.pendingAcks.get(messageId);
+  if (!pending || !pending.delivered || pending.read) return;
+
+  pending.read = true;
+  message.status = 'READ';
+  message.readAt = Date.now();
+  
+  const senderWs = connections.get(message.from);
+  if (senderWs && senderWs.readyState === WebSocket.OPEN) {
+    senderWs.send(JSON.stringify({ type: 'read', messageId }));
+  }
+}
+
+module.exports = { initializeMessages, processMessage, sendAck, sendReadAck };
